
{
  "entity": "employee",
  "version": "1.0",
  "fields": {
    "employee_id": {
      "type": "string",
      "required": true,
      "description": "Unique employee identifier"
    },
    "first_name": {
      "type": "string",
      "required": true,
      "description": "Employee's first/given name"
    },
    "last_name": {
      "type": "string",
      "required": true,
      "description": "Employee's family/surname"
    },
    "email": {
      "type": "email",
      "required": true,
      "description": "Employee's work email address"
    },
    "phone": {
      "type": "string",
      "required": false,
      "description": "Employee's phone number"
    },
    "date_of_birth": {
      "type": "date",
      "required": false,
      "description": "Employee's date of birth in YYYY-MM-DD format"
    },
    "hire_date": {
      "type": "date",
      "required": false,
      "description": "Employee's employment start date in YYYY-MM-DD format"
    },
    "department": {
      "type": "string",
      "required": false,
      "description": "Employee's organizational department"
    }
  }
}