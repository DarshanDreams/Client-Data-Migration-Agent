APP_NAME=Client Data Migration Agent
APP_ENV=development
LOG_LEVEL=INFO

AUTO_APPROVAL_THRESHOLD=0.85
ESCALATION_THRESHOLD=0.60

MAX_VALIDATION_ATTEMPTS=2
MAX_API_RETRIES=3

TARGET_API_URL=http://localhost:8000

DATABASE_URL=sqlite:///./migration.db

AI_MAPPING_ENABLED=true
AI_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
AI_SIMILARITY_WEIGHT=0.60
RULE_SIMILARITY_WEIGHT=0.40